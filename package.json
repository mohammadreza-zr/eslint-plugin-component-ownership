{
  "name": "@mrzr/eslint-plugin-component-ownership",
  "version": "0.1.0",
  "description": "ESLint rules that keep a React component the owner of its file and of its look: one component per file, and no visual Tailwind classes outside the component.",
  "keywords": ["eslint", "eslintplugin", "eslint-plugin", "react", "component", "tailwind", "lint"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadreza-zr/eslint-plugin-component-ownership.git"
  },
  "homepage": "https://github.com/mohammadreza-zr/eslint-plugin-component-ownership#readme",
  "bugs": {
    "url": "https://github.com/mohammadreza-zr/eslint-plugin-component-ownership/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "docs:sync": "bash scripts/sync-wiki.sh",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.0"
  }
}
